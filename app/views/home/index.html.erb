<% content_for :page_title, "Dashboard" %>

<%= render "shared/page_header", title: "Dashboard", subtitle: "Welcome to your inventory management system" do %>
  <%= render "shared/button", label: "Add Product", icon: "fa-plus", variant: "primary", size: "md", path: "#" %>
  <%= render "shared/button", label: "Export", icon: "fa-download", variant: "secondary", size: "md", path: "#" %>
<% end %>

<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
  <div class="bg-white rounded-lg shadow-sm border border-slate-200 p-4">
    <div class="flex items-center">
      <div class="p-3 rounded-full bg-indigo-100 text-indigo-600">
        <i class="fas fa-cube text-xl"></i>
      </div>
      <div class="ml-4">
        <p class="text-sm text-slate-500">Total Products</p>
        <p class="text-2xl font-semibold">1,245</p>
      </div>
    </div>
  </div>
  <!-- Add more stat cards similar -->
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
  <div class="lg:col-span-2">
    <%= render "shared/card", title: "Recent Stock Movements" do %>
      <!-- Placeholder table -->
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-slate-200">
          <thead class="bg-slate-50">
            <tr>
              <th class="px-4 py-2 text-left text-xs font-medium text-slate-500 uppercase">Product</th>
              <th class="px-4 py-2 text-left text-xs font-medium text-slate-500 uppercase">Type</th>
              <th class="px-4 py-2 text-left text-xs font-medium text-slate-500 uppercase">Quantity</th>
              <th class="px-4 py-2 text-left text-xs font-medium text-slate-500 uppercase">Date</th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-slate-200">
            <tr>
              <td class="px-4 py-2 text-sm">Product A</td>
              <td class="px-4 py-2 text-sm">Inbound</td>
              <td class="px-4 py-2 text-sm">50</td>
              <td class="px-4 py-2 text-sm">2025-04-01</td>
            </tr>
            <!-- More rows -->
          </tbody>
        </table>
      </div>
    <% end %>
  </div>
  <div>
    <%= render "shared/card", title: "Low Stock Alerts" do %>
      <ul class="space-y-2">
        <li class="flex items-center justify-between">
          <span class="text-sm">Product B</span>
          <span class="text-xs bg-red-100 text-red-800 px-2 py-1 rounded-full">5 left</span>
        </li>
      </ul>
    <% end %>
  </div>
</div>