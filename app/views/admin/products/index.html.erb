<% content_for :page_title, "Products" %>

<%= render "shared/page_header", title: "Products", subtitle: "Manage your inventory" do %>
  <%= render "shared/button", label: "New Product", icon: "fa-plus", variant: "primary", size: "md", path: new_admin_product_path %>
<% end %>

<!-- Filters Card -->
<div class="bg-white rounded-lg shadow-sm border border-slate-200 p-4 mb-6">
  <%= form_with(url: admin_products_path, method: :get, local: true, class: "space-y-4") do |f| %>
    <%= hidden_field_tag :sort, params[:sort] %>
    <%= hidden_field_tag :direction, params[:direction] %>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
      <div>
        <%= f.label :search, "Search", class: "block text-sm font-medium text-slate-700 mb-1" %>
        <%= f.text_field :search, value: params[:search], class: "p-3 block w-full rounded-md border-slate-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm", placeholder: "Name or SKU" %>
      </div>
      <div>
        <%= f.label :category_id, "Category", class: "block text-sm font-medium text-slate-700 mb-1" %>
        <%= f.select :category_id, options_from_collection_for_select(@categories, :id, :name, params[:category_id]), { include_blank: "All Categories" }, class: "p-3 block w-full rounded-md border-slate-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
      </div>
      <div>
        <%= f.label :supplier_id, "Supplier", class: "block text-sm font-medium text-slate-700 mb-1" %>
        <%= f.select :supplier_id, options_from_collection_for_select(@suppliers, :id, :company_name, params[:supplier_id]), { include_blank: "All Suppliers" }, class: "p-3 block w-full rounded-md border-slate-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
      </div>
      <div>
        <%= f.label :stock_status, "Stock Status", class: "block text-sm font-medium text-slate-700 mb-1" %>
        <%= f.select :stock_status, options_for_select([["In Stock", "in_stock"], ["Low Stock", "low_stock"], ["Out of Stock", "out_of_stock"]], params[:stock_status]), { include_blank: "All" }, class: "p-3 block w-full rounded-md border-slate-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
      </div>
      <div>
        <%= f.label :status, "Status", class: "block text-sm font-medium text-slate-700 mb-1" %>
        <%= f.select :status, options_for_select(Product::STATUS_OPTIONS.map { |s| [s.titleize, s] }, params[:status]), { include_blank: "All" }, class: "p-3 block w-full rounded-md border-slate-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
      </div>
    </div>
    <div class="flex justify-end">
      <%= button_tag type: :submit, class: "p-3 inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" do %>
        <i class="fas fa-filter mr-2"></i> Apply Filters
      <% end %>
      <%= link_to "Clear", admin_products_path, class: "ml-2 inline-flex items-center px-4 py-2 border border-slate-300 rounded-md shadow-sm text-sm font-medium text-slate-700 bg-white hover:bg-slate-50 focus:outline-none" %>
    </div>
  <% end %>
</div>

<% if @products.any? %>
  <div class="bg-white rounded-lg shadow-sm border border-slate-200 overflow-hidden">
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-slate-200">
        <thead class="bg-slate-50">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">
              <%= link_to admin_products_path(request.query_parameters.merge(sort: 'name', direction: params[:sort] == 'name' && params[:direction] == 'asc' ? 'desc' : 'asc')), class: "group inline-flex items-center hover:text-slate-700" do %>
                Product
                <% if params[:sort] == 'name' %>
                  <i class="fas fa-sort-<%= params[:direction] == 'asc' ? 'up' : 'down' %> ml-1 text-slate-400"></i>
                <% else %>
                  <i class="fas fa-sort ml-1 text-slate-300 group-hover:text-slate-400"></i>
                <% end %>
              <% end %>
            </th>
            <th class="px-4 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">SKU</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">Category</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">Supplier</th>
            <th class="px-4 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">
              <%= link_to admin_products_path(request.query_parameters.merge(sort: 'selling_price', direction: params[:sort] == 'selling_price' && params[:direction] == 'asc' ? 'desc' : 'asc')), class: "group inline-flex items-center hover:text-slate-700" do %>
                Price
                <% if params[:sort] == 'selling_price' %>
                  <i class="fas fa-sort-<%= params[:direction] == 'asc' ? 'up' : 'down' %> ml-1 text-slate-400"></i>
                <% else %>
                  <i class="fas fa-sort ml-1 text-slate-300 group-hover:text-slate-400"></i>
                <% end %>
              <% end %>
            </th>
            <th class="px-4 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">
              <%= link_to admin_products_path(request.query_parameters.merge(sort: 'stock_quantity', direction: params[:sort] == 'stock_quantity' && params[:direction] == 'asc' ? 'desc' : 'asc')), class: "group inline-flex items-center hover:text-slate-700" do %>
                Stock
                <% if params[:sort] == 'stock_quantity' %>
                  <i class="fas fa-sort-<%= params[:direction] == 'asc' ? 'up' : 'down' %> ml-1 text-slate-400"></i>
                <% else %>
                  <i class="fas fa-sort ml-1 text-slate-300 group-hover:text-slate-400"></i>
                <% end %>
              <% end %>
            </th>
            <th class="px-4 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">Status</th>
            <th class="px-4 py-3 text-right text-xs font-medium text-slate-500 uppercase tracking-wider">Actions</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-slate-200">
          <% @products.each do |product| %>
            <tr class="hover:bg-slate-50 transition-colors">
              <td class="px-4 py-4 whitespace-nowrap text-sm font-medium text-slate-900">
                <%= link_to product.name, admin_product_path(product), class: "hover:text-indigo-600" %>
              </td>
              <td class="px-4 py-4 whitespace-nowrap text-sm text-slate-500"><%= product.sku %></td>
              <td class="px-4 py-4 whitespace-nowrap text-sm text-slate-500"><%= product.category&.name || "—" %></td>
              <td class="px-4 py-4 whitespace-nowrap text-sm text-slate-500"><%= product.supplier&.company_name || "—" %></td>
              <td class="px-4 py-4 whitespace-nowrap text-sm text-slate-500">
                <%= number_to_currency(product.selling_price, unit: "₱ ") %>
              </td>
              <td class="px-4 py-4 whitespace-nowrap text-sm text-slate-500">
                <span class="font-medium"><%= product.stock_quantity %></span>
              </td>
              <td class="px-4 py-4 whitespace-nowrap text-sm">
                <% case product.stock_status %>
                <% when 'in_stock' %>
                  <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                    <i class="fas fa-circle mr-1 text-green-500"></i> In Stock
                  </span>
                <% when 'low_stock' %>
                  <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-orange-100 text-orange-800">
                    <i class="fas fa-exclamation-triangle mr-1 text-orange-500"></i> Low Stock
                  </span>
                <% when 'out_of_stock' %>
                  <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
                    <i class="fas fa-times-circle mr-1 text-red-500"></i> Out of Stock
                  </span>
                <% end %>
                <% if product.status == 'inactive' %>
                  <span class="ml-1 inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-slate-100 text-slate-800">
                    Inactive
                  </span>
                <% end %>
              </td>
              <td class="px-4 py-4 whitespace-nowrap text-right text-sm font-medium">
                <div class="flex justify-end space-x-2">
                  <%= link_to admin_product_path(product), class: "text-indigo-600 hover:text-indigo-900", title: "View" do %>
                    <i class="fas fa-eye"></i>
                  <% end %>
                  <%= link_to edit_admin_product_path(product), class: "text-amber-600 hover:text-amber-900", title: "Edit" do %>
                    <i class="fas fa-edit"></i>
                  <% end %>
                  <%= button_to admin_product_path(product), method: :delete, class: "text-red-600 hover:text-red-900", title: "Delete", data: { turbo_confirm: "Are you sure you want to delete this product?" } do %>
                    <i class="fas fa-trash"></i>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
  
  <%= render "shared/pagination", pagy: @pagy %>
  
<% else %>
  <div class="bg-white rounded-lg shadow-sm border border-slate-200 p-8 text-center">
    <i class="fas fa-cube text-4xl text-slate-300 mb-3"></i>
    <p class="text-slate-500 mb-4">No products found. Try adjusting filters or add your first product.</p>
    <%= render "shared/button", label: "New Product", icon: "fa-plus", variant: "primary", size: "md", path: new_admin_product_path %>
  </div>
<% end %>