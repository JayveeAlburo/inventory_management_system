<%= form_with(model: [:admin, @product], local: true, class: "space-y-6") do |form| %>
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
    <div>
      <%= form.label :name, class: "block text-sm font-medium text-slate-700" %>
      <%= form.text_field :name, class: "p-2 mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm", placeholder: "Product name" %>
      <% if @product.errors[:name].any? %>
        <p class="mt-1 text-sm text-red-600"><%= @product.errors[:name].first %></p>
      <% end %>
    </div>

    <div>
      <%= form.label :sku, class: "block text-sm font-medium text-slate-700" %>
      <%= form.text_field :sku, class: "p-2 mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm", placeholder: "SKU" %>
      <% if @product.errors[:sku].any? %>
        <p class="mt-1 text-sm text-red-600"><%= @product.errors[:sku].first %></p>
      <% end %>
    </div>

    <div class="sm:col-span-2">
      <%= form.label :description, class: "block text-sm font-medium text-slate-700" %>
      <%= form.text_area :description, rows: 3, class: "p-2 mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm", placeholder: "Product description" %>
    </div>

    <div>
      <%= form.label :category_id, class: "block text-sm font-medium text-slate-700" %>
      <%= form.collection_select :category_id, Category.order(:name), :id, :name, { prompt: "Select Category" }, class: "p-2 mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
      <% if @product.errors[:category_id].any? %>
        <p class="mt-1 text-sm text-red-600"><%= @product.errors[:category_id].first %></p>
      <% end %>
    </div>

    <div>
      <%= form.label :supplier_id, class: "block text-sm font-medium text-slate-700" %>
      <%= form.collection_select :supplier_id, Supplier.order(:company_name), :id, :company_name, { prompt: "Select Supplier" }, class: "p-2 mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
      <% if @product.errors[:supplier_id].any? %>
        <p class="mt-1 text-sm text-red-600"><%= @product.errors[:supplier_id].first %></p>
      <% end %>
    </div>

    <div>
      <%= form.label :cost_price, class: "block text-sm font-medium text-slate-700" %>
      <%= form.number_field :cost_price, step: "0.01", class: "p-2 mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm", placeholder: "0.00" %>
      <% if @product.errors[:cost_price].any? %>
        <p class="mt-1 text-sm text-red-600"><%= @product.errors[:cost_price].first %></p>
      <% end %>
    </div>

    <div>
      <%= form.label :selling_price, class: "block text-sm font-medium text-slate-700" %>
      <%= form.number_field :selling_price, step: "0.01", class: "p-2 mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm", placeholder: "0.00" %>
      <% if @product.errors[:selling_price].any? %>
        <p class="mt-1 text-sm text-red-600"><%= @product.errors[:selling_price].first %></p>
      <% end %>
    </div>

    <div>
      <%= form.label :minimum_stock, class: "block text-sm font-medium text-slate-700" %>
      <%= form.number_field :minimum_stock, min: 0, class: "p-2 mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm", placeholder: "0" %>
      <% if @product.errors[:minimum_stock].any? %>
        <p class="mt-1 text-sm text-red-600"><%= @product.errors[:minimum_stock].first %></p>
      <% end %>
    </div>

    <div>
      <%= form.label :unit, class: "block text-sm font-medium text-slate-700" %>
      <%= form.text_field :unit, class: "p-2 mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm", placeholder: "e.g., pcs, kg, box" %>
    </div>

    <div>
      <%= form.label :status, class: "block text-sm font-medium text-slate-700" %>
      <%= form.select :status, Product::STATUS_OPTIONS.map { |s| [s.titleize, s] }, {}, class: "p-2 mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
      <% if @product.errors[:status].any? %>
        <p class="mt-1 text-sm text-red-600"><%= @product.errors[:status].first %></p>
      <% end %>
    </div>
  </div>

  <div class="flex justify-end space-x-3">
    <%= link_to "Cancel", admin_products_path, class: "inline-flex items-center px-4 py-2 border border-slate-300 rounded-md shadow-sm text-sm font-medium text-slate-700 bg-white hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
    <%= form.submit class: "inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
  </div>
<% end %>