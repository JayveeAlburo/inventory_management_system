<% content_for :page_title, @product.name %>

<div class="mb-6">
  <div class="flex items-center justify-between">
    <div>
      <nav class="text-sm text-slate-500 mb-1">
        <%= link_to "Products", admin_products_path, class: "hover:text-indigo-600" %>
        <span class="mx-1">/</span>
        <span class="text-slate-700"><%= @product.name %></span>
      </nav>
      <h1 class="text-2xl font-bold text-slate-900"><%= @product.name %></h1>
      <p class="mt-1 text-sm text-slate-500">
        <%= @product.sku %>
        <% if @product.status == 'inactive' %>
          <span class="ml-2 inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-slate-100 text-slate-800">Inactive</span>
        <% end %>
      </p>
    </div>
    <div class="flex space-x-2">
      <%= render "shared/button", label: "Back", icon: "fa-arrow-left", variant: "secondary", size: "md", path: admin_products_path(@product) %>
      <%= render "shared/button", label: "Edit", icon: "fa-edit", variant: "secondary", size: "md", path: edit_admin_product_path(@product) %>
      <%= button_to admin_product_path(@product), method: :delete, class: "inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-red-600 hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500", data: { turbo_confirm: "Are you sure you want to delete this product?" } do %>
        <i class="fas fa-trash mr-2"></i> Delete
      <% end %>
    </div>
  </div>
</div>

<!-- Product Details -->
<div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-6">
  <div class="lg:col-span-2">
    <%= render "shared/card", title: "Product Information" do %>
      <dl class="grid grid-cols-1 sm:grid-cols-2 gap-x-4 gap-y-4">
        <div class="sm:col-span-2">
          <dt class="text-sm font-medium text-slate-500">Description</dt>
          <dd class="mt-1 text-sm text-slate-900"><%= @product.description.presence || "—" %></dd>
        </div>
        <div>
          <dt class="text-sm font-medium text-slate-500">Category</dt>
          <dd class="mt-1 text-sm text-slate-900"><%= @product.category&.name || "—" %></dd>
        </div>
        <div>
          <dt class="text-sm font-medium text-slate-500">Supplier</dt>
          <dd class="mt-1 text-sm text-slate-900"><%= @product.supplier&.company_name || "—" %></dd>
        </div>
        <div>
          <dt class="text-sm font-medium text-slate-500">Unit</dt>
          <dd class="mt-1 text-sm text-slate-900"><%= @product.unit.presence || "—" %></dd>
        </div>
        <div>
          <dt class="text-sm font-medium text-slate-500">SKU</dt>
          <dd class="mt-1 text-sm text-slate-900"><%= @product.sku %></dd>
        </div>
      </dl>
    <% end %>
  </div>

  <div>
    <%= render "shared/card", title: "Pricing & Inventory" do %>
      <dl class="space-y-4">
        <div>
          <dt class="text-sm font-medium text-slate-500">Cost Price</dt>
          <dd class="mt-1 text-lg font-semibold text-slate-900"><%= number_to_currency(@product.cost_price, unit: "₱") %></dd>
        </div>
        <div>
          <dt class="text-sm font-medium text-slate-500">Selling Price</dt>
          <dd class="mt-1 text-lg font-semibold text-slate-900"><%= number_to_currency(@product.selling_price, unit: "₱") %></dd>
        </div>
        <div>
          <dt class="text-sm font-medium text-slate-500">Stock Quantity</dt>
          <dd class="mt-1 text-lg font-semibold <%= @product.stock_status == 'out_of_stock' ? 'text-red-600' : '' %>"><%= @product.stock_quantity %></dd>
        </div>
        <div>
          <dt class="text-sm font-medium text-slate-500">Minimum Stock</dt>
          <dd class="mt-1 text-sm text-slate-900"><%= @product.minimum_stock %></dd>
        </div>
        <div>
          <dt class="text-sm font-medium text-slate-500">Stock Status</dt>
          <dd class="mt-1">
            <% case @product.stock_status %>
            <% when 'in_stock' %>
              <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                <i class="fas fa-circle mr-1 text-green-500"></i> In Stock
              </span>
            <% when 'low_stock' %>
              <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-orange-100 text-orange-800">
                <i class="fas fa-exclamation-triangle mr-1 text-orange-500"></i> Low Stock
              </span>
            <% when 'out_of_stock' %>
              <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
                <i class="fas fa-times-circle mr-1 text-red-500"></i> Out of Stock
              </span>
            <% end %>
          </dd>
        </div>
      </dl>
    <% end %>
  </div>
</div>

<!-- Recent Stock Movements -->
<div>
  <%= render "shared/card", title: "Recent Stock Movements" do %>
    <% if @recent_stock_movements.any? %>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-slate-200">
          <thead class="bg-slate-50">
            <tr>
              <th class="px-4 py-2 text-left text-xs font-medium text-slate-500 uppercase">Type</th>
              <th class="px-4 py-2 text-left text-xs font-medium text-slate-500 uppercase">Quantity</th>
              <th class="px-4 py-2 text-left text-xs font-medium text-slate-500 uppercase">Date</th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-slate-200">
            <% @recent_stock_movements.each do |movement| %>
              <tr class="hover:bg-slate-50 transition-colors">
                <td class="px-4 py-2 text-sm">
                  <span class="<%= movement.movement_type == 'stock_in' ? 'text-green-600' : 'text-red-600' %>">
                    <%= movement.movement_type == 'stock_in' ? 'Inbound' : 'Outbound' %>
                  </span>
                </td>
                <td class="px-4 py-2 text-sm"><%= movement.quantity %></td>
                <td class="px-4 py-2 text-sm text-slate-500"><%= movement.created_at.strftime("%b %d, %Y %H:%M") %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="text-sm text-slate-500 py-4 text-center">No stock movements recorded yet.</p>
    <% end %>
  <% end %>
</div>