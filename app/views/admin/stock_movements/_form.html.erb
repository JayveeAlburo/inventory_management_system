<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
  <!-- Left: Form -->
  <div class="bg-white rounded-lg shadow-sm border border-slate-200 p-6">
    <%= form_with(model: [:admin, @stock_movement], url: admin_stock_movements_path, local: true, class: "space-y-6") do |form| %>
      <%= form.hidden_field :movement_type, value: @stock_movement.movement_type %>

      <!-- Product field -->
      <div>
        <%= form.label :product_id, "Product", class: "block text-sm font-medium text-slate-700" %>
        <%= form.collection_select :product_id, @products, :id, :name, { prompt: "Select Product" }, class: "p-3 mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
        <% if @stock_movement.errors[:product_id].any? %>
          <p class="mt-1 text-sm text-red-600"><%= @stock_movement.errors[:product_id].first %></p>
        <% end %>
      </div>

      <!-- Quantity field -->
      <div>
        <%= form.label :quantity, class: "block text-sm font-medium text-slate-700" %>
        <%= form.number_field :quantity, step: 1, class: "p-3 mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm", placeholder: "Enter quantity" %>
        <% if @stock_movement.errors[:quantity].any? %>
          <p class="mt-1 text-sm text-red-600"><%= @stock_movement.errors[:quantity].first %></p>
        <% end %>
      </div>

      <!-- Reason field -->
      <div>
        <%= form.label :reason, class: "block text-sm font-medium text-slate-700" %>
        <%= form.text_area :reason, rows: 3, class: "p-3 mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm", placeholder: "Reason for movement (optional)" %>
      </div>

      <!-- Buttons -->
      <div class="flex justify-end space-x-3">
        <%= link_to "Cancel", admin_stock_movements_path, class: "inline-flex items-center px-4 py-2 border border-slate-300 rounded-md shadow-sm text-sm font-medium text-slate-700 bg-white hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
        <%= form.submit "Record #{@stock_movement.movement_type == 'stock_in' ? 'Stock In' : 'Stock Out'}", class: "inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
      </div>
    <% end %>
  </div>

  <!-- Right: Product list table -->
  <div class="bg-white rounded-lg shadow-sm border border-slate-200 overflow-hidden">
    <div class="px-4 py-3 border-b border-slate-200 bg-slate-50">
      <h3 class="text-lg font-medium text-slate-800">Current Stock</h3>
    </div>
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-slate-200">
        <thead class="bg-slate-50">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">Product</th>
            <th class="px-4 py-3 text-right text-xs font-medium text-slate-500 uppercase tracking-wider">Stock</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-slate-200">
          <% @products.each do |product| %>
            <tr class="hover:bg-slate-50 transition-colors">
              <td class="px-4 py-3 text-sm font-medium text-slate-900"><%= product.name %></td>
              <td class="px-4 py-3 text-sm text-right text-slate-500"><%= product.stock_quantity %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>