<%= form_with(model: [:admin, @supplier], local: true, class: "space-y-6") do |form| %>
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
    <div>
      <%= form.label :company_name, class: "block text-sm font-medium text-slate-700" %>
      <%= form.text_field :company_name, class: "p-2 mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm", placeholder: "e.g., TechSupply Co." %>
      <% if @supplier.errors[:company_name].any? %>
        <p class="mt-1 text-sm text-red-600"><%= @supplier.errors[:company_name].first %></p>
      <% end %>
    </div>

    <div>
      <%= form.label :contact_person, class: "block text-sm font-medium text-slate-700" %>
      <%= form.text_field :contact_person, class: "p-2 mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm", placeholder: "e.g., John Doe" %>
      <% if @supplier.errors[:contact_person].any? %>
        <p class="mt-1 text-sm text-red-600"><%= @supplier.errors[:contact_person].first %></p>
      <% end %>
    </div>

    <div>
      <%= form.label :email, class: "block text-sm font-medium text-slate-700" %>
      <%= form.email_field :email, class: "p-2 mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm", placeholder: "supplier@example.com" %>
      <% if @supplier.errors[:email].any? %>
        <p class="mt-1 text-sm text-red-600"><%= @supplier.errors[:email].first %></p>
      <% end %>
    </div>

    <div>
      <%= form.label :phone, class: "block text-sm font-medium text-slate-700" %>
      <%= form.text_field :phone, class: "p-2 mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm", placeholder: "+1 (555) 123-4567" %>
    </div>

    <div class="sm:col-span-2">
      <%= form.label :address, class: "block text-sm font-medium text-slate-700" %>
      <%= form.text_area :address, rows: 3, class: "p-2 mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm", placeholder: "Street, City, Country" %>
    </div>

    <div>
      <%= form.label :status, class: "block text-sm font-medium text-slate-700" %>
      <%= form.select :status, Supplier::STATUS_OPTIONS.map { |s| [s.titleize, s] }, {}, class: "p-2 mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
    </div>

    <div class="sm:col-span-2">
      <%= form.label :notes, class: "block text-sm font-medium text-slate-700" %>
      <%= form.text_area :notes, rows: 4, class: "p-2 mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm", placeholder: "Additional notes about this supplier" %>
    </div>
  </div>

  <div class="flex justify-end space-x-3">
    <%= link_to "Cancel", admin_suppliers_path, class: "inline-flex items-center px-4 py-2 border border-slate-300 rounded-md shadow-sm text-sm font-medium text-slate-700 bg-white hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
    <%= form.submit class: "inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
  </div>
<% end %>