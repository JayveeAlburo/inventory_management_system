<% content_for :page_title, @supplier.company_name %>

<div class="mb-6">
  <div class="flex items-center justify-between">
    <div>
      <nav class="text-sm text-slate-500 mb-1">
        <%= link_to "Suppliers", admin_suppliers_path, class: "hover:text-indigo-600" %>
        <span class="mx-1">/</span>
        <span class="text-slate-700"><%= @supplier.company_name %></span>
      </nav>
      <h1 class="text-2xl font-bold text-slate-900"><%= @supplier.company_name %></h1>
      <p class="mt-1 text-sm text-slate-500">
        <% if @supplier.status == 'active' %>
          <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
            <i class="fas fa-circle mr-1 text-green-500"></i> Active
          </span>
        <% else %>
          <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-slate-100 text-slate-800">
            <i class="fas fa-circle mr-1 text-slate-400"></i> Inactive
          </span>
        <% end %>
      </p>
    </div>
    <div class="flex space-x-2">
      <%= render "shared/button", label: "Back", icon: "fa-arrow-left", variant: "secondary", size: "md", path: admin_suppliers_path(@supplier) %>
      <%= render "shared/button", label: "Edit", icon: "fa-edit", variant: "secondary", size: "md", path: edit_admin_supplier_path(@supplier) %>
      <%= button_to admin_supplier_path(@supplier), method: :delete, class: "inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-red-600 hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500", data: { turbo_confirm: "Are you sure you want to delete this supplier?" } do %>
        <i class="fas fa-trash mr-2"></i> Delete
      <% end %>
    </div>
  </div>
</div>

<div class="mb-6">
  <%= render "shared/card", title: "Supplier Details" do %>
    <dl class="grid grid-cols-1 sm:grid-cols-2 gap-x-4 gap-y-4">
      <div>
        <dt class="text-sm font-medium text-slate-500">Company Name</dt>
        <dd class="mt-1 text-sm text-slate-900"><%= @supplier.company_name %></dd>
      </div>
      <div>
        <dt class="text-sm font-medium text-slate-500">Contact Person</dt>
        <dd class="mt-1 text-sm text-slate-900"><%= @supplier.contact_person.presence || "—" %></dd>
      </div>
      <div>
        <dt class="text-sm font-medium text-slate-500">Email</dt>
        <dd class="mt-1 text-sm text-slate-900"><%= @supplier.email.presence || "—" %></dd>
      </div>
      <div>
        <dt class="text-sm font-medium text-slate-500">Phone</dt>
        <dd class="mt-1 text-sm text-slate-900"><%= @supplier.phone.presence || "—" %></dd>
      </div>
      <div class="sm:col-span-2">
        <dt class="text-sm font-medium text-slate-500">Address</dt>
        <dd class="mt-1 text-sm text-slate-900"><%= @supplier.address.presence || "—" %></dd>
      </div>
      <div class="sm:col-span-2">
        <dt class="text-sm font-medium text-slate-500">Notes</dt>
        <dd class="mt-1 text-sm text-slate-900"><%= @supplier.notes.presence || "—" %></dd>
      </div>
      <div>
        <dt class="text-sm font-medium text-slate-500">Created</dt>
        <dd class="mt-1 text-sm text-slate-900"><%= @supplier.created_at.strftime("%b %d, %Y %H:%M") %></dd>
      </div>
    </dl>
  <% end %>
</div>

<div>
  <%= render "shared/card", title: "Products Supplied by #{@supplier.company_name}" do %>
    <% if @products.any? %>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-slate-200">
          <thead class="bg-slate-50">
            <tr>
              <th class="px-4 py-2 text-left text-xs font-medium text-slate-500 uppercase">Name</th>
              <th class="px-4 py-2 text-left text-xs font-medium text-slate-500 uppercase">SKU</th>
              <th class="px-4 py-2 text-left text-xs font-medium text-slate-500 uppercase">Category</th>
              <th class="px-4 py-2 text-left text-xs font-medium text-slate-500 uppercase">Stock</th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-slate-200">
            <% @products.each do |product| %>
              <tr class="hover:bg-slate-50 transition-colors">
                <td class="px-4 py-2 text-sm font-medium text-slate-900"><%= product.name %></td>
                <td class="px-4 py-2 text-sm text-slate-500"><%= product.sku %></td>
                <td class="px-4 py-2 text-sm text-slate-500"><%= product.category&.name || "—" %></td>
                <td class="px-4 py-2 text-sm"><%= product.stock_quantity %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="text-sm text-slate-500 py-4 text-center">No products supplied by this supplier yet.</p>
    <% end %>
  <% end %>
</div>