<% content_for :page_title, @category.name %>

<div class="mb-6">
  <div class="flex items-center justify-between">
    <div>
      <nav class="text-sm text-slate-500 mb-1">
        <%= link_to "Categories", admin_categories_path, class: "hover:text-indigo-600" %>
        <span class="mx-1">/</span>
        <span class="text-slate-700"><%= @category.name %></span>
      </nav>
      <h1 class="text-2xl font-bold text-slate-900"><%= @category.name %></h1>
      <p class="mt-1 text-sm text-slate-500"><%= @category.description.presence || "No description provided." %></p>
    </div>
    <div class="flex space-x-2">
      <%= render "shared/button", label: "Back", icon: "fa-arrow-left", variant: "secondary", size: "md", path: admin_categories_path(@category) %>
      <%= render "shared/button", label: "Edit", icon: "fa-edit", variant: "secondary", size: "md", path: edit_admin_category_path(@category) %>
      <%= button_to admin_category_path(@category), method: :delete, class: "inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-red-600 hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500", data: { turbo_confirm: "Are you sure you want to delete this category?" } do %>
        <i class="fas fa-trash mr-2"></i> Delete
      <% end %>
    </div>
  </div>
</div>

<div class="mb-6">
  <%= render "shared/card", title: "Category Details" do %>
    <dl class="grid grid-cols-1 sm:grid-cols-2 gap-x-4 gap-y-4">
      <div>
        <dt class="text-sm font-medium text-slate-500">Name</dt>
        <dd class="mt-1 text-sm text-slate-900"><%= @category.name %></dd>
      </div>
      <div>
        <dt class="text-sm font-medium text-slate-500">Created</dt>
        <dd class="mt-1 text-sm text-slate-900"><%= @category.created_at.strftime("%b %d, %Y %H:%M") %></dd>
      </div>
      <div class="sm:col-span-2">
        <dt class="text-sm font-medium text-slate-500">Description</dt>
        <dd class="mt-1 text-sm text-slate-900"><%= @category.description.presence || "—" %></dd>
      </div>
      <div>
        <dt class="text-sm font-medium text-slate-500">Total Products</dt>
        <dd class="mt-1 text-sm text-slate-900"><%= @products.count %></dd>
      </div>
    </dl>
  <% end %>
</div>

<div>
  <%= render "shared/card", title: "Products in this Category" do %>
    <% if @products.any? %>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-slate-200">
          <thead class="bg-slate-50">
            <tr>
              <th class="px-4 py-2 text-left text-xs font-medium text-slate-500 uppercase">Name</th>
              <th class="px-4 py-2 text-left text-xs font-medium text-slate-500 uppercase">SKU</th>
              <th class="px-4 py-2 text-left text-xs font-medium text-slate-500 uppercase">Stock</th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-slate-200">
            <% @products.each do |product| %>
              <tr class="hover:bg-slate-50 transition-colors">
                <td class="px-4 py-2 text-sm font-medium text-slate-900"><%= product.name %></td>
                <td class="px-4 py-2 text-sm text-slate-500"><%= product.sku %></td>
                <td class="px-4 py-2 text-sm"><%= product.stock_quantity %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="text-sm text-slate-500 py-4 text-center">No products in this category yet.</p>
    <% end %>
  <% end %>
</div>