<% if pagy.pages > 1 %>
  <div class="mt-4 flex flex-col sm:flex-row items-center justify-between gap-3">
    <p class="text-sm text-slate-600">
      Showing <span class="font-medium"><%= pagy.from %></span> to 
      <span class="font-medium"><%= pagy.to %></span> of 
      <span class="font-medium"><%= pagy.count %></span> results
    </p>
    
    <div class="flex flex-wrap items-center justify-center gap-1">
      <% if pagy.prev %>
        <%= link_to url_for(request.query_parameters.merge(page: pagy.prev)), class: "px-3 py-1 border border-slate-300 rounded-md text-sm text-slate-700 bg-white hover:bg-slate-50" do %>
          <i class="fas fa-chevron-left"></i> <span class="hidden sm:inline">Prev</span>
        <% end %>
      <% else %>
        <span class="px-3 py-1 border border-slate-200 rounded-md text-sm text-slate-400 bg-slate-50 cursor-not-allowed">
          <i class="fas fa-chevron-left"></i> <span class="hidden sm:inline">Prev</span>
        </span>
      <% end %>

      <% pagy.series.each do |item| %>
        <% if item == :gap %>
          <span class="px-2 py-1 text-sm text-slate-500">…</span>
        <% elsif item.is_a?(Integer) %>
          <%= link_to url_for(request.query_parameters.merge(page: item)), 
              class: "px-3 py-1 border rounded-md text-sm #{item == pagy.page ? 'border-indigo-500 bg-indigo-50 text-indigo-700' : 'border-slate-300 bg-white text-slate-700 hover:bg-slate-50'}" do %>
            <%= item %>
          <% end %>
        <% end %>
      <% end %>

      <% if pagy.next %>
        <%= link_to url_for(request.query_parameters.merge(page: pagy.next)), class: "px-3 py-1 border border-slate-300 rounded-md text-sm text-slate-700 bg-white hover:bg-slate-50" do %>
          <span class="hidden sm:inline">Next</span> <i class="fas fa-chevron-right"></i>
        <% end %>
      <% else %>
        <span class="px-3 py-1 border border-slate-200 rounded-md text-sm text-slate-400 bg-slate-50 cursor-not-allowed">
          <span class="hidden sm:inline">Next</span> <i class="fas fa-chevron-right"></i>
        </span>
      <% end %>
    </div>
  </div>
<% end %>