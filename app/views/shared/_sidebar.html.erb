<%# app/views/shared/_sidebar.html.erb %>
<aside
  data-sidebar-target="sidebar"
  class="fixed inset-y-0 left-0 z-30 w-64 bg-slate-900 text-white transform -translate-x-full transition-transform duration-300 ease-in-out lg:translate-x-0 lg:static lg:inset-auto lg:z-auto lg:h-screen lg:sticky lg:top-0 flex flex-col"
>
  <!-- sidebar header / logo -->
  <div class="flex items-center justify-center h-16 border-b border-slate-700">
    <h1 class="text-xl font-semibold text-white">
      <i class="fas fa-boxes mr-2"></i> InventoryMS
    </h1>
  </div>

  <!-- navigation -->
  <nav class="mt-5 px-4 space-y-1 flex-1">
    <%= link_to admin_dashboard_path, class: "flex items-center px-3 py-2 text-sm font-medium rounded-md #{request.path.start_with?('/admin/dashboard') ? 'bg-slate-800 text-white' : 'text-slate-300 hover:bg-slate-800 hover:text-white'} transition-colors" do %>
      <i class="fas fa-tachometer-alt w-5 h-5 mr-2"></i> Dashboard
    <% end %>

    <%= link_to admin_products_path, class: "flex items-center justify-between px-3 py-2 text-sm font-medium rounded-md #{request.path.start_with?('/admin/products') ? 'bg-slate-800 text-white' : 'text-slate-300 hover:bg-slate-800 hover:text-white'} transition-colors" do %>
      <span class="flex items-center">
        <i class="fas fa-cube w-5 h-5 mr-2"></i> Products
      </span>
      <% if low_stock_count > 0 %>
        <span class="inline-flex items-center justify-center px-2 py-0.5 text-xs font-medium rounded-full bg-red-100 text-red-800">
          <%= low_stock_count %>
        </span>
      <% end %>
    <% end %>

    <%= link_to admin_categories_path, class: "flex items-center px-3 py-2 text-sm font-medium rounded-md #{request.path.start_with?('/admin/categories') ? 'bg-slate-800 text-white' : 'text-slate-300 hover:bg-slate-800 hover:text-white'} transition-colors" do %>
      <i class="fas fa-tags w-5 h-5 mr-2"></i> Categories
    <% end %>

    <%= link_to admin_suppliers_path, class: "flex items-center px-3 py-2 text-sm font-medium rounded-md #{request.path.start_with?('/admin/suppliers') ? 'bg-slate-800 text-white' : 'text-slate-300 hover:bg-slate-800 hover:text-white'} transition-colors" do %>
      <i class="fas fa-truck w-5 h-5 mr-2"></i> Suppliers
    <% end %>

    <%= link_to admin_stock_movements_path, class: "flex items-center px-3 py-2 text-sm font-medium rounded-md #{request.path.start_with?('/admin/stock_movements') ? 'bg-slate-800 text-white' : 'text-slate-300 hover:bg-slate-800 hover:text-white'} transition-colors" do %>
      <i class="fas fa-exchange-alt w-5 h-5 mr-2"></i> Stock Movements
    <% end %>

    <%= link_to admin_inventory_report_path, class: "flex items-center px-3 py-2 text-sm font-medium rounded-md #{request.path.start_with?('/admin/reports') ? 'bg-slate-800 text-white' : 'text-slate-300 hover:bg-slate-800 hover:text-white'} transition-colors" do %>
      <i class="fas fa-chart-bar w-5 h-5 mr-2"></i> Reports
    <% end %>
  </nav>

  <!-- gogout button -->
  <div class="p-4 border-t border-slate-700">
    <%= button_to logout_path, method: :delete, class: "w-full flex items-center px-3 py-2 text-sm font-medium rounded-md text-slate-300 hover:bg-slate-800 hover:text-white transition-colors", data: { turbo_confirm: "Are you sure you want to logout?" } do %>
      <i class="fas fa-sign-out-alt w-5 h-5 mr-2"></i> Logout
    <% end %>
  </div>

  <!-- footer -->
  <div class="p-4 border-t border-slate-700">
    <p class="text-xs text-slate-400">© 2026 InventoryMS</p>
  </div>
</aside>

<!-- overlay for mobile -->
<div
  data-sidebar-target="overlay"
  class="hidden fixed inset-0 z-20 bg-black bg-opacity-50 lg:hidden"
  data-action="click->sidebar#close"
></div>