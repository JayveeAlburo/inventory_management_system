<div class="w-full max-w-md">
  <div class="bg-white rounded-lg shadow-sm border border-slate-200 pt-15 pb-15 pl-13 pr-13">

    <div class="text-center mb-6">
      <i class="fas fa-boxes text-4xl text-indigo-600"></i>
      <h1 class="mt-2 text-2xl font-bold text-slate-900">InventoryMS</h1>
      <p class="text-sm text-slate-500">Admin Login</p>
    </div>

    <% if flash[:alert] %>
      <div class="mb-4 px-4 py-3 rounded-md text-sm font-medium bg-red-50 text-red-800 border border-red-200">
        <i class="fas fa-exclamation-circle mr-1"></i>
        <%= flash[:alert] %>
      </div>
    <% end %>

    <%= form_with(
      url: login_path,
      local: true,
      class: "space-y-4",
      data: {
        controller: "login-form",
        action: "submit->login-form#validate"
      },
      novalidate: true
    ) do |f| %>

      <!-- Email -->
      <div>
        <%= f.label :email,
          class: "block text-sm font-medium text-slate-700" %>

        <%= f.email_field :email,
          class: "p-3 mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-base sm:text-sm",
          placeholder: "admin@example.com",
          data: {
            login_form_target: "email",
            action: "input->login-form#clearError"
          } %>

        <p
          class="hidden mt-1 text-sm text-red-600"
          data-login-form-target="emailError">
        </p>
      </div>

      <!-- Password -->
      <div>
        <%= f.label :password,
          class: "block text-sm font-medium text-slate-700" %>

        <%= f.password_field :password,
          class: "p-3 mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-base sm:text-sm",
          placeholder: "••••••",
          data: {
            login_form_target: "password",
            action: "input->login-form#clearError"
          } %>

        <p
          class="hidden mt-1 text-sm text-red-600"
          data-login-form-target="passwordError">
        </p>
      </div>

      <!-- Submit -->
      <div>
        <%= f.submit "Log In",
          class: "w-full flex justify-center p-2 border border-transparent rounded-md shadow-sm text-1xl font-bold text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
      </div>
    <% end %>
  </div>
</div>
